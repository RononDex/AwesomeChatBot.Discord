<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyVersion>1.9.2.0</AssemblyVersion>
		<Version>1.9.2</Version>
		<Author>RononDex</Author>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<PackageReleaseNotes>
			- Update dependencies
		</PackageReleaseNotes>
		<Description>
			This package will allow your bot built with the AweomeChatBot framework to access discord.
			For further documentation see the project site.
		</Description>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="LICENSE" Pack="true" PackagePath="/"/>
		<None Include="README.md" Pack="true" PackagePath="/"/>
	</ItemGroup>
	<PropertyGroup>
		<NoWarn>CSE0003;CC0038;IDE0008;CC0035;CC0045;CC0042;CC0076</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.20.2"/>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="AwesomeChatBot" Version="1.9.2"/>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<ProjectReference Include="../AwesomeChatBot/AwesomeChatBot/AwesomeChatBot.csproj"/>
	</ItemGroup>
</Project>
